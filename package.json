{
  "name": "stream-scheduler-2",
  "productName": "Stream Scheduler 2",
  "version": "2.4.8",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "fixtures": "bash scripts/make-fixtures.sh",
    "rehearsal": "node scripts/rehearsal.js",
    "rehearsal:resume": "node scripts/rehearsal-resume.js",
    "rehearsal:brain": "node scripts/brain-rehearsal.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "release:mac": "bash scripts/release-mac.sh",
    "rehearsal:pacing": "node scripts/rehearsal-pacing.js"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^43.0.0",
    "electron-builder": "26.4.0"
  },
  "build": {
    "appId": "com.echelonfit.stream-scheduler2",
    "productName": "Stream Scheduler 2",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "justingonz96-creator",
      "repo": "stream-scheduler-2"
    },
    "files": [
      "app/**",
      "engine/**",
      "portal/**",
      "schedule/**",
      "store/**",
      "renderer/**",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "afterSign": "build/notarize.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/ffmpeg/mac-arm64",
          "to": "ffmpeg/mac-arm64"
        },
        {
          "from": "resources/ffmpeg/mac-x64",
          "to": "ffmpeg/mac-x64"
        }
      ],
      "x64ArchFiles": "Contents/Resources/ffmpeg/**"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/ffmpeg/win-x64",
          "to": "ffmpeg/win-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
