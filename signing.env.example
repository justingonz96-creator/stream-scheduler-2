# Copy this file to  signing.env  (which is git-ignored and never committed),
# then fill in your values. Used only when building a Mac release to notarize the
# app with Apple. See docs/SIGNING.md for how to get each value.
#
# Simplest option — Apple ID + app-specific password:
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop
APPLE_TEAM_ID=XXXXXXXXXX

# Advanced alternative (instead of the three above) — App Store Connect API key:
# APPLE_API_KEY=/Users/you/keys/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
